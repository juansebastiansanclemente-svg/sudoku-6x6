<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sudoku.controller.SudokuController">
    <top>
        <HBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="nuevoJuegoButton" mnemonicParsing="false" text="Nuevo Juego" />
                <Button fx:id="ayudaButton" mnemonicParsing="false" text="Ayuda" />
            </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="20.0" />
         </padding>
        </HBox>
    </top>
    <center>
        <GridPane fx:id="tableroGrid" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="tablero" BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="60.0" prefHeight="60.0" />
                <RowConstraints minHeight="60.0" prefHeight="60.0" />
                <RowConstraints minHeight="60.0" prefHeight="60.0" />
                <RowConstraints minHeight="60.0" prefHeight="60.0" />
                <RowConstraints minHeight="60.0" prefHeight="60.0" />
                <RowConstraints minHeight="60.0" prefHeight="60.0" />
            </rowConstraints>
        </GridPane>
    </center>
   <bottom>
          <Label fx:id="mensajeLabel" alignment="CENTER" text="Presiona Nuevo Juego para iniciar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>
